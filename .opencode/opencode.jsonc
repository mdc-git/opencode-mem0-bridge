{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "-local.mem0-bridge",
    "-local.mem0-bridge.*",
    {
      "package": "./",
      "options": {
        "command": ["/Storage/Development/mem0/run.sh"],
        "automaticExtraction": true,
        "extractionModel": "openai/gpt-5.6-luna#xhigh"
      }
    }
  ]
}
